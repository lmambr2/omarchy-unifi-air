{
  "schemaVersion": 1,
  "id": "lane.unifi-air",
  "name": "UniFi Air",
  "version": "1.1.0",
  "author": "lane",
  "license": "MIT",
  "description": "Live UniFi Protect UP-AirQuality readings on the Omarchy bar: AQI and CO2 at a glance, full metrics in the panel.",
  "homepage": "https://github.com/lmambr2/omarchy-unifi-air",
  "repository": "https://github.com/lmambr2/omarchy-unifi-air",
  "keywords": ["unifi", "protect", "air-quality", "aqi", "co2"],
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "UnifiAirWidget.qml"
  },
  "barWidget": {
    "displayName": "UniFi Air",
    "description": "Always-visible AQI and CO2 from a UniFi Protect air quality sensor",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showCo2": true,
      "fahrenheit": true,
      "compact": false,
      "refreshSec": 30,
      "sensorName": ""
    },
    "schema": [
      {
        "key": "showCo2",
        "type": "boolean",
        "label": "Show CO2 next to AQI on the bar",
        "defaultValue": true
      },
      {
        "key": "fahrenheit",
        "type": "boolean",
        "label": "Temperature in Fahrenheit",
        "defaultValue": true
      },
      {
        "key": "compact",
        "type": "boolean",
        "label": "Compact bar label (numbers only)",
        "defaultValue": false
      },
      {
        "key": "refreshSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "sensorName",
        "type": "string",
        "label": "Sensor name (blank = first UP-AirQuality)",
        "defaultValue": ""
      }
    ]
  }
}
